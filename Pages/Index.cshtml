@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";

    var random = new Random();
    
}


<section>
    <ul class="tags">
@*         hx-trigger="load, click"
 *@        
        <li><h2>flags-game</h2</li>
        <li class="btn btn-success" hx-vals="js:{ TagColorCss: 'btn-success', TagParamsStr: 'mode: 0, random: true' }" hx-get="/api/Flag/TagButtons" hx-target="#tag-buttons">
            Normal
        </li>
        <li class="btn btn-success btn-warning" hx-vals="js:{ TagColorCss: 'btn-success btn-warning', TagParamsStr: 'mode: 1' }" hx-get="/api/Flag/TagButtons" hx-target="#tag-buttons">
            Easy
        </li>

        <li class="btn btn-warning" hx-vals="js:{ TagColorCss: 'btn-warning', TagParamsStr: 'mode: 2, random: true, fails: ' + get_fails() }" hx-get="/api/Flag/TagButtons" hx-target="#tag-buttons">
            Previously wrong
        </li>

        <li class="btn btn-secondary" hx-vals="js:{ TagColorCss: 'btn-secondary', TagParamsStr: 'answers: true, mode:3' }" hx-get="/api/Flag/TagButtons" hx-target="#tag-buttons">
            Solutions
        </li>
    </ul>
    <div id="tag-buttons"></div>
</section>


<div id="flags-grid" class="flags-grid">

</div>

