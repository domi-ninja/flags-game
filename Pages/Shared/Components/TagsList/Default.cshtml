@model TagsListModel
@{
    var random = new Random();
}



<hr />
<ul class="tags">
    <li class="btn @Model.TagColorCss" hx-post="@Url.Content("~/api/Flag/ListQuestion")" hx-vals='js:{ @Model.TagParamsStr }' hx-target="#flags-grid" hx-trigger="load, click">All</li>

    @foreach (var tag in Model.Tags)
    {
        <li class="btn @Model.TagColorCss" hx-post="@Url.Content("~/api/Flag/ListQuestion")" hx-vals='js:{  @Model.TagParamsStr , "tagId": @tag.Id}' hx-target="#flags-grid">@tag.name</li>
    }

    <div style="min-height: 82px;" hx-get="@Url.Content("~/api/Color/RelevantCombos")" hx-vals="js:{ TagColorCss: '@Model.TagColorCss', TagParamsStr: '@Model.TagParamsStr'}" hx-trigger="load"></div>

</ul>
