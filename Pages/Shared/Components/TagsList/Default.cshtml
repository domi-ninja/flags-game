@model TagsListModel
@{
    var random = new Random();
}
<b>Solutions</b>
<ul>
    <li class="btn btn-secondary" hx-get="/api/Flag/List" hx-vals='{"seed":@(random.NextInt64()%100)}' hx-target="#flag-list">All</li>
    <li class="btn btn-secondary" hx-get="/api/Flag/List" hx-vals='{"seed":@(random.NextInt64()%100), "tagId": -1}' hx-target="#flag-list">Untagged</li>

    @foreach (var tag in Model.Tags)
    {
        <li class="btn btn-secondary" hx-get="/api/Flag/List" hx-vals='{"tagId": @tag.Id}' hx-target="#flag-list">@tag.name</li>
    }
</ul>
<hr />

<b>Trials</b>
<ul>
    <li class="btn btn-primary" hx-get="/api/Flag/ListQuestion" hx-vals='{}' hx-target="#flag-list">All</li>
    <li class="btn btn-primary" hx-get="/api/Flag/ListQuestion" hx-vals='{"tagId": -1}' hx-target="#flag-list">Untagged</li>

    @foreach (var tag in Model.Tags)
    {
        <li class="btn btn-primary" hx-get="/api/Flag/ListQuestion" hx-vals='{"seed":@(random.NextInt64()%100), "tagId": @tag.Id}' hx-target="#flag-list">@tag.name</li>
    }
</ul>
<hr />
