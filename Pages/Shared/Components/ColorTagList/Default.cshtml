@model ColorTagListModel




    @foreach (var tag in Model.tags)
    {
    <li class="btn @Model.TagColorCss" hx-post="/api/Flag/ListQuestion" hx-vals="js:{ flagIds: [ @(string.Join(",", tag.flags.Select(f => f.Id))) ], @Model.TagParamsStr, minPop: false }" hx-target="#flags-grid">
            
        @foreach (var color in tag.colors )
        {
            <div class="color" style="background-color: @color.color; display: inline-block; width: 10px; height: 10px;">
            </div>
        }
        @tag.flagsCount
    </li>

    }