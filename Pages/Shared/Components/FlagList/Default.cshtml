@using flags_game.Pages.Shared.Components.TagsList

@model FlagListModel
@{
    var random = new Random();
}


<div id="flag-list">


    <section>
        <div id="flags-grid" class="flags-grid" style="display: flex">
            @foreach (var flag in Model.Flags)
            {
                flag.flagTags = new List<Models.FlagTag>();
                <text>
                    @await Component.InvokeAsync(typeof(XFlagViewComponent), new XFlagModel()
                    {
                        flag = flag,
                        answerable = false,
                       answeringStats = Model?.answeringStats?.GetValueOrDefault(flag.Id) ?? new AnswerStat()
                    })
                </text>
            }
        </div>
    </section>
</div>