@model XFlagModel
@{
    var r = new Random();
}

<div class="flag-grid">
    <div class="flag">
        <div class="img-wrapper">
            @if (!Model.answerable)
            {
                <a href="/flags/big/@(Model.flag.url.Replace("/flags/", ""))?v=3">
                    <img src="/flags/small/@(Model.flag.url.Replace("/flags/", ""))?v=3" />
                </a>
            }
            else
            {
                <img src="/flags/small/@(Model.flag.url.Replace("/flags/", ""))?v=3" />
            }
        </div>
        <div class="flag-detail">
 

            @if (Model.answeringStats != null)
            {
                if (Model.answeringStats.right > 0)
                {
                    <text>
                        <span class="right badge bg-success">
                            @Model.answeringStats.right
                        </span>
                    </text>
                }
                if (Model.answeringStats.wrong > 0)
                {
                    <text>
                        <span class="wrong badge bg-danger">
                            @Model.answeringStats.wrong
                        </span>
                    </text>
                }
                if ( Model.answeringStats.right == 0 && Model.answeringStats.wrong == 0)
                {
                    <text>
                        <span class="badge bg-secondary">
                            0
                        </span>
                    </text>
                }

            }
            else if (@Model.flag.population != 0)
            {
                <span>@(MathF.Floor(Model.flag.population / 10000f) / 100f) M</span>
            }

            @if (!Model.answerable)
            {
                <p class="flag-name"><b>@Model.flag.name</b></p>
                @foreach (var tag in Model.flag.flagTags)
                {
                    <div class="badge bg-secondary">@tag.Tag.name</div>
                }

                @*                 @if (Model.flag.colorTags != null) {
            @foreach (var colorTag in Model.flag.colorTags)
            {
            <div class="color" style="background-color: @colorTag.FlagColor.rgb">
            @colorTag.FlagColor.name.ToCharArray().FirstOrDefault()
            </div>
            }
            } *@
            }
            else
            {
                <p class="flag-name hidden"><b>@Model.flag.name</b></p>
                <input class="form-control" type="search"
                       name="search" placeholder=""
                       hx-target=".country-suggestions-@Model.flag.Id"
                       hx-on:keyup="playOnType(event, @Model.flag.Id)"
                       hx-on:blur="playOnBlur(event)"
                       autocomplete="off">
                <div class="country-suggestions country-suggestions-@Model.flag.Id">
                </div>
            }
        </div>
    </div>
</div>

