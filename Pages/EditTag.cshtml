 *@



@*
<div hx-post="/flags/api/Flag/Tag" hx-trigger="">

</div>

asp-controller="Flag" asp-action="Tag"
*@
<section>

    <div>
        <section>
            <h2> Editing Tag </h2>
            <input hx-vals='{"Id": @Model.Tag.Id}' name="name" type="text" value="@Model.Tag.name" class="tag"
                   hx-put="/flags/api/Flag/Tag" hx-trigger="keyup changed delay:0.5s" hx-swap="None" />

            <a class="btn btn-primary" href="/Edit"> Back</a>

            @* hx-include="#antiforgery"*@

            <div class="row">
                <div class="col-2 clicky">
                    @foreach (var flagTag in Model.Tag.flagTags)
                    {
                        @*<div class="flag" hx-vals='{"TagId": @Model.Tag.Id, FlagId: @flag.Id}' hx-post="/flags/api/Flag/FlagTag">*@


                        <div class="flag">
                            <div class="img-wrapper">
                                <img src="flags/small/@flagTag.Flag.url.Replace("/flags", "")" alt="@flagTag.Flag.name" />
                            </div>
                            <div class="flag-detail">
                                <form asp-page-handler="RemoveFlagTag" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="Id" value="@flagTag.Id" />
                                    <input type="hidden" name="TagId" value="@Model.Tag.Id" />
                                    <input type="submit" value="-">
                                </form>
                                <p><b>@flagTag.Flag.name</b></p>
                            </div>
                        </div>
                    }
                </div>

                <div class="flags-grid col clicky">
                    @foreach (var flag in Model.Flags )
                    {
                        @* .Where( f=> ! Model.Tag.flagTags.Any( (ft) => ft.FlagId == f.Id ) ) *@

                        @*<div class="flag" hx-vals='{"TagId": @Model.Tag.Id, FlagId: @flag.Id}' hx-post="/flags/api/Flag/FlagTag">*@


                        @*                                 <div class="flag" hx-vals='{"TagId": @Model.Tag.Id, FlagId: @flag.Id}' hx-post="/flags/api/Flag/FlagTag">
                    *@
                        <div id="flag-@flag.Id"></div>
                        string conditionalClasses = "";
                        if ( Model.Tag.flagTags.Any( (ft) => ft.FlagId == flag.Id ) ){
                            conditionalClasses+="hidden";
                        }
                        <div class="flag @conditionalClasses" >
                            <div class="img-wrapper">
                                <img src="flags/small/@flag.url.Replace("/flags", "")" alt="@flag.name" />
                            </div>
                            <div class="flag-detail">
                                <form asp-page-handler="AddFlagTag" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="TagId" value="@Model.Tag.Id" />
                                    <input type="hidden" name="FlagId" value="@flag.Id" />
                                    <input type="submit" value="+">
                                </form>
                                <p>
                                    <span>@flag.Id</span><br>
                                    <span>@flag.population</span><br>
                                    <b>@flag.name</b>
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <hr />
        </section>
    </div>

</section>

