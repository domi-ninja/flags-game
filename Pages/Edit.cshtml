</div>

asp-controller="Flag" asp-action="Tag"
*@
<section>
    <h2>Tags</h2>

    <section>
        <form asp-page-handler="Tag" method="post" enctype="multipart/form-data">
            <input type="text" name="newTagName" />
            <input type="submit" value="Add">
        </form>

    </section>

    <form id="antiforgery">
        @Html.AntiForgeryToken()
    </form>

    <ul>
        @foreach (var tag in Model.Tags)
        {
            <li class="tag-@tag.Id" id="tag-@tag.Id">
                <section>
                    <input hx-vals='{"Id": @tag.Id}' name="name" type="text" value="@tag.name" class="tag"
                        hx-put="@Url.Content("~/api/Flag/Tag")" hx-trigger="keyup changed delay:0.5s" hx-swap="None" />
                    <button hx-vals='{"tagId": @tag.Id}' class="" hx-delete="@Url.Content("~/api/Flag/Tag")" hx-target=".tag-@tag.Id"
                        hx-swap="outerHTML">
                        X
                    </button>
                    <a class="btn btn-primary" style="margin-left: 3em;" href="@Url.Page("/EditTag", new { tagId = tag.Id })"> Edit </a>
                    @* hx-include="#antiforgery"*@

                    <div class="flags-grid">
                        @foreach (var flagTag in tag.flagTags)
                        {
                            <text>
                                @await Component.InvokeAsync(typeof(FlagMiniViewComponent), flagTag.Flag)
                            </text>
                        }
                    </div>

                    <hr />
                </section>
            </li>
        }
    </ul>
</section>
<section>
    <div>
        <h2>Flags</h2> <br>
        <form asp-page-handler="SyncFlags" method="post" enctype="multipart/form-data">
            <input type="submit" value="SyncFlags">
        </form>
        <br>
        <pre id="sync-logs">
@Model.Logs
        </pre>
    </div>
    <div class="flags-grid">
        @foreach (var flag in Model.Flags)
        {
            <text>
                @await Component.InvokeAsync(typeof(XFlagViewComponent), new XFlagModel(){
                    flag = flag
                })
            </text>
        }
    </div>
</section>
